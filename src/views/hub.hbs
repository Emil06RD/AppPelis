<div class="row min-vh-100 align-items-center justify-content-center fade-in pb-5">
    <div class="col-md-10 col-lg-8 text-center">
        <div class="hub-header mb-5">
            <h1 class="hub-title">Love <span>App</span></h1>
            <p class="hub-subtitle">Seleccioná una aplicación para iniciar</p>
        </div>

        <div class="row justify-content-center g-4">
            <!-- Love View App Card -->
            <div class="col-sm-6 col-md-4">
                <a href="/love-view" class="text-decoration-none h-100 d-block">
                    <div class="hub-card lv-glass-card p-4 h-100 text-center transition-all">
                        <div class="hub-icon-wrap" style="background: rgba(255,133,161,0.15); border-color: rgba(255,133,161,0.3);">
                            <i class="fas fa-film" style="color: #ff85a1;"></i>
                        </div>
                        <h3 class="hub-card-title">Love <span style="color:#ff85a1;">View</span></h3>
                        <p class="hub-card-sub">Gestión de series y películas que vemos juntos.</p>
                    </div>
                </a>
            </div>
            <!-- Citas y Lugares App Card -->
            <div class="col-sm-6 col-md-4">
                <a href="/dates" class="text-decoration-none h-100 d-block">
                    <div class="hub-card lv-glass-card p-4 h-100 text-center transition-all">
                        <div class="hub-icon-wrap" style="background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.3);">
                            <i class="fas fa-heart" style="color: #ef4444;"></i>
                        </div>
                        <h3 class="hub-card-title">Planes y <span>Citas</span></h3>
                        <p class="hub-card-sub">Guardá los mejores recuerdos y lugares para visitar.</p>
                    </div>
                </a>
            </div>
            <!-- Musica Card (Placeholder) -->
            <div class="col-sm-6 col-md-4">
                <a href="#" class="text-decoration-none h-100 d-block" onclick="alert('¡Próximamente!'); return false;">
                    <div class="hub-card lv-glass-card p-4 h-100 text-center transition-all" style="opacity: 0.7;">
                        <div class="hub-icon-wrap" style="background: rgba(245,158,11,0.15); border-color: rgba(245,158,11,0.3);">
                            <i class="fas fa-music" style="color: #f59e0b;"></i>
                        </div>
                        <h3 class="hub-card-title">44-<span>FM</span></h3>
                        <p class="hub-card-sub">Compartí y puntuá tus canciones favoritas.</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Small Messages Widget -->
        {{#if canEdit}}
        <div class="row justify-content-center mt-5 fade-in" style="animation-delay: 0.2s;">
            <div class="col-auto">
                <a href="/messages" class="text-decoration-none">
                    <div class="hub-widget lv-glass-card d-flex align-items-center justify-content-center flex-column transition-all">
                        <i class="fas fa-envelope-open-text mb-2" style="color: #a78bfa; font-size: 1.8rem;"></i>
                        <span class="fw-bold" style="font-size: 0.8rem; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px;">Mensajes</span>
                    </div>
                </a>
            </div>
        </div>
        {{/if}}
    </div>
</div>


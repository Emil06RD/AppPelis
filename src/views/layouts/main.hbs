<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Love App</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    {{#if isPlanner}}
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/planner.css">
    {{/if}}
    {{#unless isLogin}}{{#unless isHub}}{{#unless isPlanner}}
    <link rel="stylesheet" href="/css/love-view.css">
    {{/unless}}{{/unless}}{{/unless}}
</head>

<body class="{{#if isLogin}}login-page{{else}}lv-dark-body{{#if isPlanner}} ed-page{{/if}}{{#unless isHub}}{{#unless isPlanner}} lv-love-page{{/unless}}{{/unless}}{{/if}}">

    {{!-- Animated dark background globally --}}
    {{#unless isLogin}}
    <div class="lv-bg-canvas" aria-hidden="true">
        <div class="lv-bg-orb lv-bg-orb-1"></div>
        <div class="lv-bg-orb lv-bg-orb-2"></div>
        <div class="lv-bg-orb lv-bg-orb-3"></div>
    </div>
    {{/unless}}

    {{#unless isLogin}}
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            {{#if isHub}}
            <a class="navbar-brand lv-navbar-brand" href="/">App <span>Hub</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarHub"
                aria-controls="navbarHub" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarHub">
                <div class="navbar-nav ms-auto gap-3 mt-3 mt-lg-0 align-items-center">
                    <span class="nav-link lv-nav-link">Sesión como: <strong>{{user.name}}</strong></span>
                    <a href="/logout" class="lv-nav-add-btn" style="background: rgba(255,80,80,0.1); color: #ff7070; box-shadow: none;">Cerrar sesión</a>
                </div>
            </div>
            {{else if isPlanner}}
            <div class="ed-brand-group">
                <a href="/" class="ed-apps-link" aria-label="Volver a mis aplicaciones" title="Mis aplicaciones"><i class="fas fa-th-large" aria-hidden="true"></i></a>
                <span class="ed-brand-divider" aria-hidden="true"></span>
                <a class="navbar-brand lv-navbar-brand ed-brand" href="/dates"><span class="ed-brand-mark" aria-hidden="true"><i class="fas fa-heart"></i></span> Entre <span>Dos</span><span class="ed-brand-caption">PLANES & RECUERDOS</span></a>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPlanner"
                aria-controls="navbarPlanner" aria-expanded="false" aria-label="Abrir navegación">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarPlanner">
                <div class="navbar-nav ms-auto gap-2 align-items-center mt-3 mt-lg-0">
                    <a href="/dates" data-ed-nav="dates" class="nav-link lv-nav-link fw-semibold"><i class="far fa-images" aria-hidden="true"></i> Recuerdos</a>
                    <a href="/places" data-ed-nav="places" class="nav-link lv-nav-link fw-semibold"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Por descubrir</a>
                    <div class="d-none d-lg-block lv-nav-divider"></div>
                    <div class="dropdown">
                        <a class="nav-link lv-nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                            role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="lv-nav-avatar">{{user.name.[0]}}</div>
                            <span class="d-none d-lg-inline">{{user.name}}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end lv-dropdown mt-2">
                            <li><span class="dropdown-item-text lv-dropdown-sub">Rol: {{user.role}}</span></li>
                            <li><hr class="dropdown-divider lv-divider-hr"></li>
                            <li><a class="dropdown-item lv-dropdown-item lv-logout-item" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Cerrar sesión</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            {{else}}
            {{!-- Love View Navbar --}}
            <div class="lv-nav-brand-group">
                <a href="/" class="lv-apps-link" title="Volver a las aplicaciones" aria-label="Volver a las aplicaciones"><i class="fas fa-th-large" aria-hidden="true"></i></a>
                <span class="lv-nav-brand-divider" aria-hidden="true"></span>
                <a class="navbar-brand lv-navbar-brand" href="/love-view"><i class="fas fa-film lv-nav-film" aria-hidden="true"></i> Love <span class="lv-brand-accent">View</span></a>
            </div>
            <div class="lv-main-nav" aria-label="Secciones de Love View">
                <a href="/love-view" data-lv-nav="collection"><i class="fas fa-layer-group" aria-hidden="true"></i> Colección</a>
                <a href="/love-view/management" data-lv-nav="management"><i class="fas fa-list-ul" aria-hidden="true"></i> Gestión</a>
                <a href="/love-view/genres" data-lv-nav="genres"><i class="fas fa-tags" aria-hidden="true"></i> Géneros</a>
            </div>
            <div class="lv-nav-actions">
                {{#if canEdit}}
                <a href="/love-view/create" class="lv-nav-add-btn lv-nav-add-desktop"><i class="fas fa-plus" aria-hidden="true"></i> Agregar</a>
                {{/if}}
                <div class="dropdown">
                    <button class="lv-user-menu dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de {{user.name}}">
                        <span class="lv-nav-avatar">{{user.name.[0]}}</span><span class="lv-user-menu-name">{{user.name}}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end lv-dropdown mt-2">
                        <li><span class="dropdown-item-text lv-dropdown-sub">Sesión de <strong>{{user.name}}</strong></span></li>
                        <li><hr class="dropdown-divider lv-divider-hr"></li>
                        <li><a class="dropdown-item lv-dropdown-item" href="/"><i class="fas fa-th-large me-2" aria-hidden="true"></i>Mis aplicaciones</a></li>
                        <li><a class="dropdown-item lv-dropdown-item lv-logout-item" href="/logout"><i class="fas fa-sign-out-alt me-2" aria-hidden="true"></i>Cerrar sesión</a></li>
                    </ul>
                </div>
            </div>
            {{/if}}
        </div>
    </nav>
    {{/unless}}

    <div class="container mt-5 lv-main-container">
        {{{body}}}
    </div>
    {{#if isPlanner}}
    <footer class="ed-footer container"><a href="/dates">Entre Dos <i class="far fa-heart" aria-hidden="true"></i></a><span>Lo bonito es compartir el camino.</span><a href="/">Volver a Love App <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></a></footer>
    <script src="/js/planner.js" defer></script>
    {{/if}}

    {{#unless isLogin}}{{#unless isHub}}{{#unless isPlanner}}
    <nav class="lv-mobile-nav" aria-label="Secciones de Love View en celular">
        <a href="/love-view" data-lv-nav="collection"><i class="fas fa-layer-group" aria-hidden="true"></i><span>Colección</span></a>
        <a href="/love-view/management" data-lv-nav="management"><i class="fas fa-list-ul" aria-hidden="true"></i><span>Gestión</span></a>
        <a href="/love-view/genres" data-lv-nav="genres"><i class="fas fa-tags" aria-hidden="true"></i><span>Géneros</span></a>
    </nav>
    <script src="/js/love-view.js" defer></script>
    {{/unless}}{{/unless}}{{/unless}}

    <!-- Floating Messages UI -->
    {{#if canEdit}}
    {{#if user}}
    {{#unless isLogin}}
    <div id="floating-message-container" class="position-fixed bottom-0 start-0 w-100 text-center"
        style="z-index: 9999; opacity: 0; pointer-events: none; transition: opacity 0.8s ease-in-out;">
        <div class="py-3 shadow-lg"
            style="background: rgba(13,13,20,0.85); backdrop-filter: blur(12px); border-top: 1px solid rgba(255, 133, 161, 0.3);">
            <i class="fas fa-heart me-2 heartbeat-anim" style="color:#ff85a1;"></i>
            <span id="floating-message-text" class="fw-bold"
                style="color: #fff; font-size: 1.1rem; word-break: break-word;"></span>
            <i class="fas fa-heart ms-2 heartbeat-anim" style="color:#ff85a1;"></i>
        </div>
    </div>

    <style>
        @keyframes heartbeat { 0%,100% { transform: scale(1); } 50% { transform: scale(1.25); } }
        .heartbeat-anim { display: inline-block; animation: heartbeat 1.5s infinite; }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const response = await fetch('/messages/api/mine');
                if (!response.ok) return;
                const messages = await response.json();
                if (messages && messages.length > 0) {
                    const container = document.getElementById('floating-message-container');
                    const textEl = document.getElementById('floating-message-text');
                    const showMessage = () => {
                        textEl.textContent = messages[Math.floor(Math.random() * messages.length)].content;
                        container.style.opacity = '1';
                        setTimeout(() => { container.style.opacity = '0'; setTimeout(showMessage, 20000); }, 5000);
                    };
                    setTimeout(showMessage, 5000);
                }
            } catch (err) { console.error('Error with floating messages:', err); }
        });
    </script>
    {{/unless}}
    {{/if}}
    {{/if}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

<a href="/dates" class="ed-back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Volver al álbum</a>
<header class="ed-detail-heading"><span class="ed-kicker">UN CAPÍTULO DE NOSOTROS</span><h1>{{#if date.title}}{{date.title}}{{else}}Cita especial{{/if}}</h1><div class="ed-detail-meta"><span><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{date.Places.name}}</span><span><i class="far fa-calendar" aria-hidden="true"></i> {{date.formattedDateTime}}</span></div>{{#if canEdit}}<div class="ed-detail-actions"><a href="/dates/edit/{{date.id}}" class="ed-button ed-button-secondary"><i class="far fa-pen-to-square" aria-hidden="true"></i> Editar recuerdo</a><form action="/dates/delete/{{date.id}}" method="GET" onsubmit="return confirm('¿Eliminar este recuerdo para siempre?');"><button type="submit" class="ed-icon-button ed-danger" aria-label="Eliminar recuerdo"><i class="far fa-trash-can" aria-hidden="true"></i></button></form></div>{{/if}}</header>
<section class="ed-detail-cover" aria-label="Fotos de portada del recuerdo">
    {{#if collagePhotos.length}}
    <div class="ed-collage ed-collage-count-{{collagePhotos.length}}">{{#each collagePhotos}}<button type="button" class="ed-collage-item ed-collage-item-{{@index}}" data-ed-photo="{{this.photo_url}}" aria-label="Ampliar foto de portada {{@index}}"><img src="{{this.photo_url}}" alt="Foto de nuestro recuerdo" {{#unless @first}}loading="lazy"{{/unless}}></button>{{/each}}</div>
    {{else if galleryPhotos.length}}
    <button type="button" class="ed-cover-single" data-ed-photo="{{galleryPhotos.[0].photo_url}}" aria-label="Ampliar foto de portada"><img src="{{galleryPhotos.[0].photo_url}}" alt="{{date.title}}"></button>
    {{else}}<div class="ed-cover-empty ed-photo-placeholder"><i class="far fa-heart" aria-hidden="true"></i><span>Hay momentos que se guardan sin una foto.</span></div>{{/if}}
    <span class="ed-cover-caption"><i class="far fa-heart" aria-hidden="true"></i> De esos días que se quedan.</span>
</section>
{{#if canViewDescription}}
<section class="ed-private-note" aria-labelledby="ed-note-title">
    <div class="ed-note-label"><i class="fas fa-quote-left" aria-hidden="true"></i><span class="ed-kicker" id="ed-note-title">LO QUE VIVIMOS</span><span class="ed-private-badge"><i class="fas fa-lock" aria-hidden="true"></i> Solo nosotros</span></div>
    {{#if date.description}}<p class="ed-note-text">{{date.description}}</p>{{else}}<p class="ed-note-empty">Cada recuerdo tiene una historia. Guardá acá los detalles que no querés olvidar.</p><a href="/dates/edit/{{date.id}}" class="ed-text-link">Escribir nuestra historia <i class="fas fa-arrow-right" aria-hidden="true"></i></a>{{/if}}
    <span class="ed-note-signature">con vos, siempre.</span>
</section>
{{/if}}
{{#if galleryPhotos.length}}
<section class="ed-gallery" aria-labelledby="ed-gallery-title">
    <div class="ed-section-heading"><div><span class="ed-kicker">UN POQUITO MÁS DE ESE DÍA</span><h2 id="ed-gallery-title">En imágenes <span class="ed-count">{{galleryPhotos.length}}</span></h2></div><div class="ed-gallery-controls"><button type="button" class="ed-icon-button" data-ed-gallery-prev aria-label="Fotos anteriores"><i class="fas fa-arrow-left" aria-hidden="true"></i></button><button type="button" class="ed-icon-button" data-ed-gallery-next aria-label="Fotos siguientes"><i class="fas fa-arrow-right" aria-hidden="true"></i></button></div></div>
    <div class="ed-gallery-track" data-ed-gallery>{{#each galleryPhotos}}<button type="button" class="ed-gallery-photo" data-ed-photo="{{this.photo_url}}" aria-label="Ampliar foto {{@index}}"><img src="{{this.photo_url}}" alt="Foto de {{../date.title}}" loading="lazy"><span aria-hidden="true"><i class="fas fa-expand"></i></span></button>{{/each}}</div>
</section>
{{/if}}
<dialog class="ed-lightbox" data-ed-lightbox aria-label="Foto ampliada"><button type="button" class="ed-lightbox-close ed-icon-button" data-ed-lightbox-close aria-label="Cerrar foto"><i class="fas fa-times" aria-hidden="true"></i></button><img src="" alt="Foto ampliada del recuerdo" data-ed-lightbox-image></dialog>

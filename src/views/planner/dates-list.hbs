<section class="ed-hero">
    <div class="ed-hero-copy">
        <span class="ed-kicker"><span></span> NUESTRA PEQUEÑA GRAN HISTORIA</span>
        <h1>Hay lugares.<br>Y luego, <em>los nuestros.</em></h1>
        <p>Las citas que se vuelven recuerdos.<br>Los momentos a los que siempre queremos volver.</p>
        <div class="ed-hero-actions">
            {{#if canEdit}}<a href="/dates/create" class="ed-button"><i class="fas fa-plus" aria-hidden="true"></i> Guardar un recuerdo</a>{{/if}}
            <a href="/places" class="ed-text-link">Nuestro próximo lugar <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="ed-hero-footnote"><span class="ed-tiny-heart" aria-hidden="true"><i class="fas fa-heart"></i></span> Un álbum de nosotros, siempre creciendo.</div>
    </div>
    <div class="ed-hero-art">
        <span class="ed-orbit ed-orbit-one" aria-hidden="true"></span><span class="ed-orbit ed-orbit-two" aria-hidden="true"></span>
        <span class="ed-art-spark ed-spark-one" aria-hidden="true">✧</span><span class="ed-art-spark ed-spark-two" aria-hidden="true">✦</span>
        <div class="ed-postcard-back" aria-hidden="true"><i class="far fa-heart"></i><span>vos + yo</span></div>
        {{#if dates.length}}
        <a href="/dates/view/{{featuredDate.id}}" class="ed-postcard" aria-label="Volver al recuerdo: {{featuredDate.title}}">
            <div class="ed-postcard-image">
                {{#if featuredDate.DatePhotos.length}}<img src="{{featuredDate.DatePhotos.[0].photo_url}}" alt="{{featuredDate.title}}" fetchpriority="high">{{else}}<div class="ed-photo-placeholder"><i class="far fa-heart" aria-hidden="true"></i><span>Un momento para guardar</span></div>{{/if}}
            </div>
            <div class="ed-postcard-caption"><span>{{#if featuredDate.title}}{{featuredDate.title}}{{else}}Cita especial{{/if}}</span><i class="far fa-heart" aria-hidden="true"></i></div>
            <span class="ed-postcard-date">{{featuredDate.formattedDateTime}}</span>
        </a>
        {{else}}
        <div class="ed-postcard"><div class="ed-postcard-image ed-photo-placeholder"><i class="far fa-heart" aria-hidden="true"></i><span>Lo mejor está por venir</span></div><div class="ed-postcard-caption"><span>Nuestra primera página</span><i class="far fa-heart" aria-hidden="true"></i></div><span class="ed-postcard-date">Un lugar. Un momento. Nosotros.</span></div>
        {{/if}}
        <span class="ed-art-label">pequeños momentos, grandes recuerdos</span>
    </div>
</section>
<section class="ed-collection" aria-labelledby="ed-collection-title" data-ed-collection>
    <div class="ed-section-heading">
        <div><span class="ed-kicker">EL ÁLBUM</span><h2 id="ed-collection-title">Momentos que se quedan <span class="ed-count">{{dates.length}}</span></h2></div>
        <span class="ed-section-aside"><i class="far fa-heart" aria-hidden="true"></i> Hechos de tiempo juntos</span>
    </div>
    {{#if dates.length}}
    <div class="ed-toolbar">
        <div class="ed-search"><i class="fas fa-search" aria-hidden="true"></i><label for="ed-search" class="visually-hidden">Buscar recuerdos por nombre o lugar</label><input id="ed-search" type="search" placeholder="Buscá un recuerdo o un lugar…" data-ed-search autocomplete="off"></div>
        <div class="ed-sort"><label for="ed-sort"><i class="fas fa-arrow-down-wide-short" aria-hidden="true"></i> Ordenar</label><select id="ed-sort" data-ed-sort><option value="recent">Más recientes</option><option value="oldest">Más antiguos</option></select></div>
    </div>
    <p class="ed-result-status visually-hidden" data-ed-results role="status" aria-live="polite"></p>
    <div class="ed-memory-grid" data-ed-grid>
        {{#each dates}}
        <article class="ed-memory-card" data-ed-card data-ed-title="{{this.title}}" data-ed-place="{{this.Places.name}}" data-ed-time="{{this.date_time}}">
            <a href="/dates/view/{{this.id}}" class="ed-memory-link">
                <div class="ed-memory-image">
                    {{#if this.DatePhotos.length}}<img src="{{this.DatePhotos.[0].photo_url}}" alt="{{this.title}}" loading="lazy">{{else}}<div class="ed-photo-placeholder"><i class="far fa-heart" aria-hidden="true"></i><span>Lo vivido no se olvida</span></div>{{/if}}
                    <div class="ed-date-stamp"><strong>{{this.day}}</strong><span>{{this.month}}</span></div>
                    {{#if this.DatePhotos.length}}<span class="ed-photo-count"><i class="far fa-images" aria-hidden="true"></i> {{this.DatePhotos.length}}<span class="visually-hidden"> fotos</span></span>{{/if}}
                    <span class="ed-card-open" aria-hidden="true"><i class="fas fa-arrow-up-right-from-square"></i></span>
                </div>
                <div class="ed-memory-info"><span class="ed-card-year">{{this.year}} <span aria-hidden="true">·</span> NUESTROS RECUERDOS</span><h3>{{#if this.title}}{{this.title}}{{else}}Cita especial{{/if}}</h3><p><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{#if this.Places.name}}{{this.Places.name}}{{else}}Un lugar especial{{/if}}</p></div>
            </a>
        </article>
        {{/each}}
    </div>
    <div class="ed-empty" data-ed-no-results hidden><i class="fas fa-search" aria-hidden="true"></i><h3>No encontramos ese recuerdo</h3><p>Probá con otro nombre o lugar.</p><button type="button" class="ed-button ed-button-secondary" data-ed-reset>Ver todos los recuerdos</button></div>
    {{else}}
    <div class="ed-empty"><span class="ed-empty-symbol"><i class="far fa-images" aria-hidden="true"></i></span><h3>Toda historia tiene un primer recuerdo.</h3><p>Una salida, una escapada o ese café que duró horas.<br>Este es su lugar para quedarse.</p>{{#if canEdit}}<a href="/dates/create" class="ed-button"><i class="fas fa-plus" aria-hidden="true"></i> Guardar el primer recuerdo</a>{{/if}}</div>
    {{/if}}
</section>
<aside class="ed-discover-banner"><div class="ed-discover-icon" aria-hidden="true"><i class="fas fa-map-location-dot"></i></div><div><span class="ed-kicker">LA HISTORIA SIGUE</span><h2>¿Y si el próximo recuerdo empieza acá?</h2><p>Todos esos lugares que algún día vamos a conocer.</p></div><a href="/places" class="ed-button ed-button-secondary">Lugares por descubrir <i class="fas fa-arrow-right" aria-hidden="true"></i></a></aside>

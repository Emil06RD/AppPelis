<div class="lv-mgmt fade-in">
    <div class="lv-mgmt-header">
        <div>
            <h1 class="lv-h1">Gestión <span>de Géneros</span> <i class="fas fa-tags" style="color:#ff85a1; font-size:1.2rem; margin-left:8px;"></i></h1>
            <p class="lv-h1-sub">Administrá las categorías de tu colección</p>
        </div>
        {{#if canEdit}}
        <a href="/love-view/genres/create" class="lv-cta-btn">
            <i class="fas fa-plus"></i> Agregar Género
        </a>
        {{/if}}
    </div>

    <div class="lv-glass-card lv-table-card" style="max-width: 600px; margin: 0 auto;">
        <div class="table-responsive">
            <table class="table lv-table mb-0">
                <thead>
                    <tr>
                        <th class="lv-th ps-4">Nombre del Género</th>
                        {{#if canEdit}}<th class="lv-th text-end pe-4">Acciones</th>{{/if}}
                    </tr>
                </thead>
                <tbody>
                    {{#each genres}}
                    <tr class="lv-tr">
                        <td class="lv-td ps-4">
                            <span class="lv-gtag" style="font-size:0.8rem; padding:4px 12px;">{{name}}</span>
                        </td>
                        {{#if @root.canEdit}}
                        <td class="lv-td text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/love-view/genres/edit/{{id}}" class="lv-mgmt-edit-btn" aria-label="Editar el género {{name}}" title="Editar {{name}}">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a href="/love-view/genres/delete/{{id}}" class="lv-mgmt-del-btn"
                                    aria-label="Eliminar el género {{name}}" title="Eliminar {{name}}" data-confirm="¿Eliminar el género «{{name}}»?">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                        {{/if}}
                    </tr>
                    {{/each}}
                    {{#unless genres.length}}
                    <tr>
                        <td colspan="{{#if canEdit}}2{{else}}1{{/if}}" class="lv-empty-td">
                            <i class="fas fa-tags me-2"></i>No hay géneros creados aún.
                        </td>
                    </tr>
                    {{/unless}}
                </tbody>
            </table>
        </div>
    </div>
</div>

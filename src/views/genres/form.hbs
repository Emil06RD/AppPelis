<div class="lv-form-wrap fade-in">
    <div class="lv-form-card" style="max-width: 500px;">
        <div class="lv-form-header">
            <a href="/love-view/genres" class="lv-back-link">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h2 class="lv-form-title">{{#if isEdit}}Editar Género{{else}}Nuevo Género{{/if}}</h2>
                <p class="lv-form-sub">{{#if isEdit}}Modificá el nombre de la categoría{{else}}Añadí una nueva categoría a la lista{{/if}}</p>
            </div>
        </div>

        <form action="{{#if isEdit}}/love-view/genres/edit/{{genre.id}}{{else}}/love-view/genres/create{{/if}}" method="POST" class="lv-form">
            <div class="lv-field">
                <label class="lv-label" for="name">Nombre del Género <span class="lv-required">*</span></label>
                <input type="text" class="lv-input" id="name" name="name" value="{{genre.name}}" required placeholder="ej. Comedia Romántica">
            </div>

            <div class="lv-form-actions mt-3">
                <button type="submit" class="lv-submit-btn">
                    <span>{{#if isEdit}}Guardar cambios{{else}}Crear género{{/if}}</span>
                    <i class="fas fa-check lv-btn-icon"></i>
                </button>
                <a href="/love-view/genres" class="lv-cancel-btn">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<div class="lv-mgmt fade-in">

    {{!-- Header --}}
    <div class="lv-mgmt-header">
        <div>
            <h1 class="lv-h1">Gestión <span>de Contenido</span></h1>
            <p class="lv-h1-sub">Administrá tu biblioteca completa</p>
        </div>
        {{#if canEdit}}
        <a href="/love-view/create" class="lv-cta-btn">
            <i class="fas fa-plus"></i> Agregar
        </a>
        {{/if}}
    </div>

    {{!-- Status filter --}}
    <div class="lv-filter-row mb-4">
        <a href="/love-view/management" class="lv-pill {{#unless currentStatus}}lv-pill-active{{/unless}}">Todos</a>
        <a href="/love-view/management?status=Watching" class="lv-pill lv-pill-watching {{#if (eq currentStatus 'Watching')}}lv-pill-active{{/if}}">
            <i class="fas fa-play-circle"></i> Viendo
        </a>
        <a href="/love-view/management?status=Plan to Watch" class="lv-pill lv-pill-ptw {{#if (eq currentStatus 'Plan to Watch')}}lv-pill-active{{/if}}">
            <i class="fas fa-bookmark"></i> Por ver
        </a>
        <a href="/love-view/management?status=Watched" class="lv-pill lv-pill-watched {{#if (eq currentStatus 'Watched')}}lv-pill-active{{/if}}">
            <i class="fas fa-check-circle"></i> Vistas
        </a>
    </div>

    {{!-- Table card --}}
    <div class="lv-glass-card lv-table-card">
        <div class="table-responsive">
            <table class="table lv-table mb-0">
                <caption class="visually-hidden">Series y películas de nuestra biblioteca</caption>
                <thead>
                    <tr>
                        <th class="lv-th" style="width:44px;"></th>
                        <th class="lv-th">Título</th>
                        <th class="lv-th">Tipo</th>
                        <th class="lv-th">Géneros</th>
                        <th class="lv-th">Estado</th>
                        <th class="lv-th">Puntuación</th>
                        {{#if canEdit}}<th class="lv-th text-end">Acciones</th>{{/if}}
                    </tr>
                </thead>
                <tbody>
                    {{#each series}}
                    <tr class="lv-tr">
                        <td class="lv-td lv-td-poster">
                            <img src="{{posterUrl}}" alt=""
                                onerror="this.onerror=null;this.src='/img/poster-fallback.svg'"
                                class="lv-mgmt-thumb">
                        </td>
                        <td class="lv-td">
                            <span class="lv-mgmt-title">{{title}}</span>
                        </td>
                        <td class="lv-td">
                            <span class="lv-mgmt-sub">
                                {{#if (eq type 'Pelicula')}}<i class="fas fa-film me-1" style="color:#ff85a1;"></i>Película
                                {{else}}<i class="fas fa-tv me-1" style="color:#a78bfa;"></i>Serie{{#if season}} T{{season}}{{/if}}{{/if}}
                            </span>
                        </td>
                        <td class="lv-td">
                            <div class="lv-mgmt-genres">
                                {{#if Genre.name}}<span class="lv-gtag">{{Genre.name}}</span>{{/if}}
                                {{#if Genre2.name}}<span class="lv-gtag">{{Genre2.name}}</span>{{/if}}
                                {{#if Genre3.name}}<span class="lv-gtag">{{Genre3.name}}</span>{{/if}}
                                {{#if Genre4.name}}<span class="lv-gtag">{{Genre4.name}}</span>{{/if}}
                            </div>
                        </td>
                        <td class="lv-td">
                            <span class="lv-status-badge
                                {{#if (eq status 'Watching')}}lv-sb-watching{{/if}}
                                {{#if (eq status 'Watched')}}lv-sb-watched{{/if}}
                                {{#if (eq status 'Plan to Watch')}}lv-sb-ptw{{/if}}">
                                {{#if (eq status 'Watching')}}Viendo
                                {{else if (eq status 'Watched')}}Vista
                                {{else}}Por ver{{/if}}
                            </span>
                        </td>
                        <td class="lv-td">
                            {{#if ratingAverage}}
                            <div class="lv-pcard-rating" style="gap:4px;">
                                <i class="fas fa-star lv-star"></i>
                                <span class="lv-rval">{{ratingAverage}}</span>
                                <span class="lv-rsub">E:{{ratingEmil}}·D:{{ratingDeli}}</span>
                            </div>
                            {{else}}<span class="lv-mgmt-sub">—</span>{{/if}}
                        </td>
                        {{#if @root.canEdit}}
                        <td class="lv-td text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/love-view/edit/{{id}}" class="lv-mgmt-edit-btn" aria-label="Editar {{title}}" title="Editar {{title}}">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a href="/love-view/delete/{{id}}" class="lv-mgmt-del-btn"
                                    aria-label="Eliminar {{title}}" title="Eliminar {{title}}" data-confirm="¿Eliminar «{{title}}»?">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                        {{/if}}
                    </tr>
                    {{/each}}
                    {{#unless series.length}}
                    <tr>
                        <td colspan="{{#if canEdit}}7{{else}}6{{/if}}" class="lv-empty-td">
                            <i class="fas fa-film me-2"></i>No hay contenido. Hacé clic en «Agregar» para empezar.
                        </td>
                    </tr>
                    {{/unless}}
                </tbody>
            </table>
        </div>
    </div>
    <p class="lv-table-hint"><i class="fas fa-arrows-alt-h" aria-hidden="true"></i> Deslizá la tabla para ver todos los datos.</p>
</div>

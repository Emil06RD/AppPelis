{{!-- ═══ LOVE VIEW — COLLECTION ═══ --}}

{{!-- ── Header ── --}}
<div class="lv-header fade-in">
    <div class="lv-header-inner">
        <div>
            <span class="lv-header-kicker">NUESTRA BIBLIOTECA, DE A DOS</span>
            <h1 class="lv-h1">Nuestra <span>colección</span></h1>
            <p class="lv-h1-sub">Todo lo que vimos y lo que queda por ver juntos</p>
        </div>
        {{#if canEdit}}
        <a href="/love-view/create" class="lv-cta-btn">
            <i class="fas fa-plus"></i> Agregar
        </a>
        {{/if}}
    </div>
</div>

<div class="lv-search-toolbar">
    <form class="lv-search-box" role="search" id="lvSearchForm">
        <label for="lvSearch" class="visually-hidden">Buscar en la colección</label>
        <i class="fas fa-search" aria-hidden="true"></i>
        <input type="search" id="lvSearch" placeholder="Buscar una serie o película…" autocomplete="off">
        <button type="button" data-clear-search aria-label="Limpiar búsqueda" hidden><i class="fas fa-times" aria-hidden="true"></i></button>
    </form>
    <span id="lvResultCount" class="lv-result-count" role="status" aria-live="polite"></span>
</div>

{{!-- ── Filters ── --}}
<div class="lv-filter-bar fade-in">

    {{!-- Type --}}
    <div class="lv-filter-row">
        <span class="lv-filter-label">Tipo</span>
        <div class="lv-filter-options" role="group" aria-label="Filtrar por tipo">
        <a href="/love-view/?{{#if currentGenreId}}genre={{currentGenreId}}{{/if}}{{#if currentStatus}}{{#if currentGenreId}}&{{/if}}status={{currentStatus}}{{/if}}"
            class="lv-pill {{#unless currentType}}lv-pill-active{{/unless}}">
            <i class="fas fa-th-large"></i> Todos
        </a>
        <a href="/love-view/?type=Serie{{#if currentGenreId}}&genre={{currentGenreId}}{{/if}}{{#if currentStatus}}&status={{currentStatus}}{{/if}}"
            class="lv-pill {{#if (eq currentType 'Serie')}}lv-pill-active{{/if}}">
            <i class="fas fa-tv"></i> Series
        </a>
        <a href="/love-view/?type=Pelicula{{#if currentGenreId}}&genre={{currentGenreId}}{{/if}}{{#if currentStatus}}&status={{currentStatus}}{{/if}}"
            class="lv-pill {{#if (eq currentType 'Pelicula')}}lv-pill-active{{/if}}">
            <i class="fas fa-film"></i> Películas
        </a>
        </div>
    </div>
    <div class="lv-filter-row">
        <span class="lv-filter-label">Estado</span>
        <div class="lv-filter-options" role="group" aria-label="Filtrar por estado">
        <a href="/love-view/?{{#if currentGenreId}}genre={{currentGenreId}}{{/if}}{{#if currentType}}{{#if currentGenreId}}&{{/if}}type={{currentType}}{{/if}}"
            class="lv-pill {{#unless currentStatus}}lv-pill-active{{/unless}}">
            Todo
        </a>
        <a href="/love-view/?status=Watching{{#if currentGenreId}}&genre={{currentGenreId}}{{/if}}{{#if currentType}}&type={{currentType}}{{/if}}"
            class="lv-pill lv-pill-watching {{#if (eq currentStatus 'Watching')}}lv-pill-active{{/if}}">
            <i class="fas fa-play-circle"></i> Viendo
        </a>
        <a href="/love-view/?status=Plan to Watch{{#if currentGenreId}}&genre={{currentGenreId}}{{/if}}{{#if currentType}}&type={{currentType}}{{/if}}"
            class="lv-pill lv-pill-ptw {{#if (eq currentStatus 'Plan to Watch')}}lv-pill-active{{/if}}">
            <i class="fas fa-bookmark"></i> Por ver
        </a>
        <a href="/love-view/?status=Watched{{#if currentGenreId}}&genre={{currentGenreId}}{{/if}}{{#if currentType}}&type={{currentType}}{{/if}}"
            class="lv-pill lv-pill-watched {{#if (eq currentStatus 'Watched')}}lv-pill-active{{/if}}">
            <i class="fas fa-check-circle"></i> Vistas
        </a>
        </div>
    </div>

    {{!-- Genre toggle --}}
    <div class="lv-genre-row">
        <button class="lv-genre-toggle-btn" type="button" data-bs-toggle="collapse" data-bs-target="#genreMenu" aria-expanded="false">
            <i class="fas fa-tags"></i>
            Elegir género
            {{#if currentGenreId}}<span class="lv-genre-dot"></span>{{/if}}
            <i class="fas fa-chevron-down lv-chevron"></i>
        </button>
        {{#if currentGenreId}}
        <span class="lv-active-genre-tag">
            <i class="fas fa-tag"></i>
            {{#each genres}}{{#if (eq ../currentGenreId id)}}{{name}}{{/if}}{{/each}}
            <a href="/love-view/?{{#if currentType}}type={{currentType}}{{/if}}{{#if currentStatus}}{{#if currentType}}&{{/if}}status={{currentStatus}}{{/if}}" class="lv-clear-genre" aria-label="Quitar el filtro de género"><i class="fas fa-times" aria-hidden="true"></i></a>
        </span>
        {{/if}}
        <a href="/love-view" id="lvResetFilters" data-clear-filters class="lv-reset-filters" hidden><i class="fas fa-undo" aria-hidden="true"></i> Restablecer</a>
        <div class="collapse" id="genreMenu">
            <div class="lv-genre-panel">
                <a href="/love-view/?{{#if currentType}}type={{currentType}}{{/if}}{{#if currentStatus}}{{#if currentType}}&{{/if}}status={{currentStatus}}{{/if}}"
                    class="lv-gpill {{#unless currentGenreId}}active{{/unless}}">Todos</a>
                {{#each genres}}
                <a href="/love-view/?genre={{id}}{{#if ../currentType}}&type={{../currentType}}{{/if}}{{#if ../currentStatus}}&status={{../currentStatus}}{{/if}}"
                    class="lv-gpill {{#if (eq ../currentGenreId id)}}active{{/if}}">{{name}}</a>
                {{/each}}
            </div>
        </div>
    </div>
</div>

<div id="lvSearchEmpty" class="lv-search-empty" hidden>
    <i class="fas fa-search" aria-hidden="true"></i>
    <h2>No encontramos ese título</h2>
    <p>Probá con otro nombre o cambiá los filtros.</p>
    <button type="button" data-clear-search>Limpiar búsqueda</button>
</div>

{{!-- ═══ SECTION: WATCHING ═══ --}}
{{#if showWatching}}
<section class="lv-section fade-in">
    <div class="lv-section-head">
        <span class="lv-sdot" style="background:#4ade80;box-shadow:0 0 8px #4ade80;"></span>
        <h2 class="lv-section-title">Viendo</h2>
        <span class="lv-scount">{{watching.length}}</span>
    </div>
    <div class="lv-grid" id="grid-watching">
        {{#if watching.length}}
            {{#each watching}}
            <div class="lv-col">
                <div class="lv-pcard {{#if (gt count 1)}}lv-pcard-grouped{{/if}}" {{#if (gt count 1)}}data-cascade="cascade-w-{{@index}}"{{/if}}>
                    {{#if (gt count 1)}}<div class="lv-stack-effect"></div>{{/if}}
                    {{#if (gt count 1)}}<span class="lv-multi-badge">{{count}} <i class="fas fa-layer-group"></i></span>{{/if}}
                    <div class="lv-pcard-img-wrap">
                        <img src="{{posterUrl}}" alt="{{title}}" class="lv-pcard-img" loading="lazy"
                            onerror="this.onerror=null;this.src='/img/poster-fallback.svg'">
                    </div>
                    <div class="lv-pcard-overlay">
                        <div class="lv-pcard-chips">
                            <span class="lv-type-chip">{{#if (eq type 'Pelicula')}}<i class="fas fa-film"></i>{{else}}<i class="fas fa-tv"></i>{{/if}}</span>
                            {{#if (eq type 'Serie')}}{{#if season}}<span class="lv-season-chip">T{{season}}</span>{{/if}}{{/if}}
                            {{#if (gt count 1)}}<button type="button" class="lv-expand-chip lv-card-toggle" aria-controls="cascade-w-{{@index}}" aria-expanded="false" aria-label="Ver las {{count}} entradas de {{title}}"><i class="fas fa-chevron-down lv-cascade-chev" aria-hidden="true"></i> Ver {{count}}</button>{{/if}}
                        </div>
                        <h6 class="lv-pcard-title">{{title}}</h6>
                        <div class="lv-pcard-genres">
                            {{#if Genre.name}}<span class="lv-gtag">{{Genre.name}}</span>{{/if}}
                            {{#if Genre2.name}}<span class="lv-gtag">{{Genre2.name}}</span>{{/if}}
                        </div>
                        {{#if ratingAverage}}
                        <div class="lv-pcard-rating">
                            <i class="fas fa-star lv-star"></i>
                            <span class="lv-rval">{{ratingAverage}}</span>
                            <span class="lv-rsub">E:{{ratingEmil}} · D:{{ratingDeli}}</span>
                        </div>
                        {{/if}}
                        {{#if @root.canEdit}}
                        <a href="/love-view/edit/{{#if (gt count 1)}}{{items.[0].id}}{{else}}{{id}}{{/if}}" class="lv-edit-overlay-btn" aria-label="Editar {{title}}" title="Editar {{title}}"><i class="fas fa-pen"></i></a>
                        {{/if}}
                    </div>
                </div>
            </div>
            {{#if (gt count 1)}}
            <div class="lv-cascade-tray" id="cascade-w-{{@index}}">
                <div class="lv-cascade-heading"><span>Entradas de {{title}}</span><button type="button" data-close-cascade><i class="fas fa-times" aria-hidden="true"></i> Cerrar</button></div>
                {{#each items}}
                <div class="lv-col lv-cascade-item">
                    <div class="lv-pcard lv-pcard-sub">
                        <div class="lv-pcard-img-wrap">
                            <img src="{{posterUrl}}" alt="{{../title}}" class="lv-pcard-img" loading="lazy"
                                onerror="this.onerror=null;this.src='/img/poster-fallback.svg'">
                        </div>
                        <div class="lv-pcard-overlay">
                            <div class="lv-pcard-chips">
                                <span class="lv-season-chip">{{#if (eq type 'Serie')}}T{{season}}{{else}}Film{{/if}}</span>
                            </div>
                            <h6 class="lv-pcard-title" style="font-size:0.78rem;">{{../title}}</h6>
                            {{#if ratingAverage}}<div class="lv-pcard-rating"><i class="fas fa-star lv-star"></i><span class="lv-rval">{{ratingAverage}}</span></div>{{/if}}
                            {{#if @root.canEdit}}<a href="/love-view/edit/{{id}}" class="lv-edit-overlay-btn" aria-label="Editar {{title}}" title="Editar {{title}}"><i class="fas fa-pen"></i></a>{{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}
            {{/each}}
        {{else}}
        <div class="lv-empty"><i class="fas fa-play-circle"></i> Nada en reproducción.</div>
        {{/if}}
    </div>
</section>
{{/if}}

{{!-- ═══ SECTION: WATCHED ═══ --}}
{{#if showWatched}}
<section class="lv-section fade-in">
    <div class="lv-section-head">
        <span class="lv-sdot" style="background:#ff85a1;box-shadow:0 0 8px #ff85a1;"></span>
        <h2 class="lv-section-title">Vistas</h2>
        <span class="lv-scount">{{watched.length}}</span>
    </div>
    <div class="lv-grid" id="grid-watched">
        {{#if watched.length}}
            {{#each watched}}
            <div class="lv-col">
                <div class="lv-pcard {{#if (gt count 1)}}lv-pcard-grouped{{/if}}" {{#if (gt count 1)}}data-cascade="cascade-wd-{{@index}}"{{/if}}>
                    {{#if (gt count 1)}}<div class="lv-stack-effect"></div>{{/if}}
                    {{#if (gt count 1)}}<span class="lv-multi-badge">{{count}} <i class="fas fa-layer-group"></i></span>{{/if}}
                    <div class="lv-pcard-img-wrap">
                        <img src="{{posterUrl}}" alt="{{title}}" class="lv-pcard-img" loading="lazy"
                            onerror="this.onerror=null;this.src='/img/poster-fallback.svg'">
                    </div>
                    <div class="lv-pcard-overlay">
                        <div class="lv-pcard-chips">
                            <span class="lv-type-chip">{{#if (eq type 'Pelicula')}}<i class="fas fa-film"></i>{{else}}<i class="fas fa-tv"></i>{{/if}}</span>
                            {{#if (gt count 1)}}<button type="button" class="lv-expand-chip lv-card-toggle" aria-controls="cascade-wd-{{@index}}" aria-expanded="false" aria-label="Ver las {{count}} entradas de {{title}}"><i class="fas fa-chevron-down lv-cascade-chev" aria-hidden="true"></i> Ver {{count}}</button>{{/if}}
                        </div>
                        <h6 class="lv-pcard-title">{{title}}</h6>
                        <div class="lv-pcard-genres">
                            {{#if Genre.name}}<span class="lv-gtag">{{Genre.name}}</span>{{/if}}
                            {{#if Genre2.name}}<span class="lv-gtag">{{Genre2.name}}</span>{{/if}}
                        </div>
                        <span class="lv-unrated-badge" {{#if (gt ratingEmil 0)}}{{#if (gt ratingDeli 0)}}hidden{{/if}}{{/if}}
                            title="{{#unless (gt ratingEmil 0)}}{{#unless (gt ratingDeli 0)}}Faltan las valoraciones de Emi y Deli{{else}}Falta la valoración de Emi{{/unless}}{{else}}Falta la valoración de Deli{{/unless}}">
                            <i class="far fa-star" aria-hidden="true"></i> Sin calificar
                        </span>
                        {{#if ratingAverage}}
                        <div class="lv-pcard-rating">
                            <i class="fas fa-star lv-star"></i>
                            <span class="lv-rval">{{ratingAverage}}</span>
                            <span class="lv-rsub">E:{{ratingEmil}} · D:{{ratingDeli}}</span>
                        </div>
                        {{/if}}
                        {{#if @root.canEdit}}<a href="/love-view/edit/{{#if (gt count 1)}}{{items.[0].id}}{{else}}{{id}}{{/if}}" class="lv-edit-overlay-btn" aria-label="Editar {{title}}" title="Editar {{title}}"><i class="fas fa-pen"></i></a>{{/if}}
                    </div>
                </div>
            </div>
            {{#if (gt count 1)}}
            <div class="lv-cascade-tray" id="cascade-wd-{{@index}}">
                <div class="lv-cascade-heading"><span>Entradas de {{title}}</span><button type="button" data-close-cascade><i class="fas fa-times" aria-hidden="true"></i> Cerrar</button></div>
                {{#each items}}
                <div class="lv-col lv-cascade-item">
                    <div class="lv-pcard lv-pcard-sub">
                        <div class="lv-pcard-img-wrap">
                            <img src="{{posterUrl}}" alt="{{../title}}" class="lv-pcard-img" loading="lazy"
                                onerror="this.onerror=null;this.src='/img/poster-fallback.svg'">
                        </div>
                        <div class="lv-pcard-overlay">
                            <div class="lv-pcard-chips"><span class="lv-season-chip">{{#if (eq type 'Serie')}}T{{season}}{{else}}Film{{/if}}</span></div>
                            <h6 class="lv-pcard-title" style="font-size:0.78rem;">{{../title}}</h6>
                            <span class="lv-unrated-badge" {{#if (gt ratingEmil 0)}}{{#if (gt ratingDeli 0)}}hidden{{/if}}{{/if}}
                                title="{{#unless (gt ratingEmil 0)}}{{#unless (gt ratingDeli 0)}}Faltan las valoraciones de Emi y Deli{{else}}Falta la valoración de Emi{{/unless}}{{else}}Falta la valoración de Deli{{/unless}}">
                                <i class="far fa-star" aria-hidden="true"></i> Sin calificar
                            </span>
                            {{#if ratingAverage}}<div class="lv-pcard-rating"><i class="fas fa-star lv-star"></i><span class="lv-rval">{{ratingAverage}}</span></div>{{/if}}
                            {{#if @root.canEdit}}<a href="/love-view/edit/{{id}}" class="lv-edit-overlay-btn" aria-label="Editar {{title}}" title="Editar {{title}}"><i class="fas fa-pen"></i></a>{{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}
            {{/each}}
        {{else}}
        <div class="lv-empty"><i class="fas fa-check-circle"></i> Nada marcado como visto aún.</div>
        {{/if}}
    </div>
</section>
{{/if}}

{{!-- ═══ SECTION: PLAN TO WATCH ═══ --}}
{{#if showPlanToWatch}}
<section class="lv-section fade-in">
    <div class="lv-section-head">
        <span class="lv-sdot" style="background:#facc15;box-shadow:0 0 8px #facc15;"></span>
        <h2 class="lv-section-title">Por Ver</h2>
        <span class="lv-scount">{{planToWatch.length}}</span>
    </div>
    <div class="lv-grid" id="grid-plan">
        {{#if planToWatch.length}}
            {{#each planToWatch}}
            <div class="lv-col">
                <div class="lv-pcard {{#if (gt count 1)}}lv-pcard-grouped{{/if}}" {{#if (gt count 1)}}data-cascade="cascade-p-{{@index}}"{{/if}}>
                    {{#if (gt count 1)}}<div class="lv-stack-effect"></div>{{/if}}
                    {{#if (gt count 1)}}<span class="lv-multi-badge">{{count}} <i class="fas fa-layer-group"></i></span>{{/if}}
                    <div class="lv-pcard-img-wrap">
                        <img src="{{posterUrl}}" alt="{{title}}" class="lv-pcard-img" loading="lazy"
                            onerror="this.onerror=null;this.src='/img/poster-fallback.svg'">
                    </div>
                    <div class="lv-pcard-overlay">
                        <div class="lv-pcard-chips">
                            <span class="lv-type-chip">{{#if (eq type 'Pelicula')}}<i class="fas fa-film"></i>{{else}}<i class="fas fa-tv"></i>{{/if}}</span>
                            {{#if (gt count 1)}}<button type="button" class="lv-expand-chip lv-card-toggle" aria-controls="cascade-p-{{@index}}" aria-expanded="false" aria-label="Ver las {{count}} entradas de {{title}}"><i class="fas fa-chevron-down lv-cascade-chev" aria-hidden="true"></i> Ver {{count}}</button>{{/if}}
                        </div>
                        <h6 class="lv-pcard-title">{{title}}</h6>
                        <div class="lv-pcard-genres">
                            {{#if Genre.name}}<span class="lv-gtag">{{Genre.name}}</span>{{/if}}
                            {{#if Genre2.name}}<span class="lv-gtag">{{Genre2.name}}</span>{{/if}}
                        </div>
                        {{#if @root.canEdit}}<a href="/love-view/edit/{{#if (gt count 1)}}{{items.[0].id}}{{else}}{{id}}{{/if}}" class="lv-edit-overlay-btn" aria-label="Editar {{title}}" title="Editar {{title}}"><i class="fas fa-pen"></i></a>{{/if}}
                    </div>
                </div>
            </div>
            {{#if (gt count 1)}}
            <div class="lv-cascade-tray" id="cascade-p-{{@index}}">
                <div class="lv-cascade-heading"><span>Entradas de {{title}}</span><button type="button" data-close-cascade><i class="fas fa-times" aria-hidden="true"></i> Cerrar</button></div>
                {{#each items}}
                <div class="lv-col lv-cascade-item">
                    <div class="lv-pcard lv-pcard-sub">
                        <div class="lv-pcard-img-wrap">
                            <img src="{{posterUrl}}" alt="{{../title}}" class="lv-pcard-img" loading="lazy"
                                onerror="this.onerror=null;this.src='/img/poster-fallback.svg'">
                        </div>
                        <div class="lv-pcard-overlay">
                            <div class="lv-pcard-chips"><span class="lv-season-chip">{{#if (eq type 'Serie')}}T{{season}}{{else}}Film{{/if}}</span></div>
                            <h6 class="lv-pcard-title" style="font-size:0.78rem;">{{../title}}</h6>
                            {{#if @root.canEdit}}<a href="/love-view/edit/{{id}}" class="lv-edit-overlay-btn" aria-label="Editar {{title}}" title="Editar {{title}}"><i class="fas fa-pen"></i></a>{{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}
            {{/each}}
        {{else}}
        <div class="lv-empty"><i class="fas fa-bookmark"></i> Lista de pendientes vacía.</div>
        {{/if}}
    </div>
</section>
{{/if}}
